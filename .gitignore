# Block build outputs
target/
build/
bin/

# Block locally stored uploaded documents
uploads/

# Block generated local TLS certs (dev-only, self-signed)
nusiss-ddas-springboot/docker/postgres-tls/certs/

# Block compiled binaries
*.class
*.jar
*.war
*.ear

# Block IDE settings (Optional but recommended)
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
# Deploy secrets and Terraform state
nusiss-ddas-springboot/deploy/.env
nusiss-ddas-springboot/infra/.terraform/
nusiss-ddas-springboot/infra/*.tfstate*

# macOS Finder files
.DS_Store

# Local deployment runbook (not committed)
nusiss-ddas-springboot/DEPLOY.md
